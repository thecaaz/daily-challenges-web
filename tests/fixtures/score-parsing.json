{
  "description": "Shared score-parsing spec. Used by backend ScoreParser (xUnit), frontend parseScore.js (vitest) and extension/scoreparse.js (vitest). 'expected' is the numeric value, or null when the input is not a valid score.",
  "rules": [
    "Trim the input. Empty -> null.",
    "The WHOLE trimmed string must be a score; surrounding text -> null.",
    "Optional leading '+' or '-' sign (numbers only, not times).",
    "Times: 'm:ss', 'h:mm:ss', each optionally followed by '.f' or ',f' (1-3 digits). Seconds/minutes after the first field must be 00-59. Value is total seconds.",
    "Grouping separators: ',', '.', space, NBSP (U+00A0), narrow NBSP (U+202F), apostrophe (U+0027) and right single quote (U+2019). When grouping is used, the first group has 1-3 digits and every following group exactly 3 digits.",
    "Decimal separator: the LAST '.' or ',' when it is followed by 1-2 digits, or when the integer part before it is '0' or empty. Otherwise a '.'/',' is a grouping separator.",
    "Anything else (exponents, fractions like 4/6, percent signs, multiple numbers) -> null."
  ],
  "cases": [
    { "input": "5", "expected": 5 },
    { "input": "0", "expected": 0 },
    { "input": "-3", "expected": -3 },
    { "input": "+7", "expected": 7 },
    { "input": "  42  ", "expected": 42 },
    { "input": "40456", "expected": 40456 },
    { "input": "40 456", "expected": 40456 },
    { "input": "40 456", "expected": 40456 },
    { "input": "40 456", "expected": 40456 },
    { "input": "40'456", "expected": 40456 },
    { "input": "40’456", "expected": 40456 },
    { "input": "1 234 567", "expected": 1234567 },
    { "input": "1,234", "expected": 1234 },
    { "input": "1.234", "expected": 1234 },
    { "input": "1,234,567", "expected": 1234567 },
    { "input": "1.234.567", "expected": 1234567 },
    { "input": "12.5", "expected": 12.5 },
    { "input": "12,5", "expected": 12.5 },
    { "input": "12.50", "expected": 12.5 },
    { "input": "1,2", "expected": 1.2 },
    { "input": "1234,56", "expected": 1234.56 },
    { "input": "1,234.56", "expected": 1234.56 },
    { "input": "1.234,56", "expected": 1234.56 },
    { "input": "1 234,5", "expected": 1234.5 },
    { "input": "1,234,567.89", "expected": 1234567.89 },
    { "input": "-1,234.5", "expected": -1234.5 },
    { "input": "0.125", "expected": 0.125 },
    { "input": ".5", "expected": 0.5 },
    { "input": "2:59", "expected": 179 },
    { "input": "2:05", "expected": 125 },
    { "input": "0:07.5", "expected": 7.5 },
    { "input": "0:07,25", "expected": 7.25 },
    { "input": "1:02:03", "expected": 3723 },
    { "input": "10:00:00", "expected": 36000 },
    { "input": "2:60", "expected": null },
    { "input": "1:60:00", "expected": null },
    { "input": "-2:30", "expected": null },
    { "input": "", "expected": null },
    { "input": "   ", "expected": null },
    { "input": "abc", "expected": null },
    { "input": "Wordle 1,234 4/6", "expected": null },
    { "input": "Round 2 5000", "expected": null },
    { "input": "Score: 1,234", "expected": null },
    { "input": "12 3", "expected": null },
    { "input": "1e+21", "expected": null },
    { "input": "12,34,567", "expected": null },
    { "input": "1.2.3", "expected": null },
    { "input": "1,23,456", "expected": null },
    { "input": "4/6", "expected": null },
    { "input": "100%", "expected": null },
    { "input": "--5", "expected": null },
    { "input": "5-", "expected": null },
    { "input": "1 234 56", "expected": null }
  ]
}
