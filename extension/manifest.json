{
  "manifest_version": 2,
  "name": "DailyChallenges ScoreBridge",
  "version": "0.5.0",
  "description": "Extension that bridges embedded game scores and cropped screenshots of the game into the DailyChallenges app.",
  "permissions": [
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "DailyChallenges ScoreBridge",
    "default_icon": "icons/favicon-96x96.png"
  },
  "icons": {
    "96": "icons/favicon-96x96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{b9dac5a9-12d3-4eec-8334-0343342947a2}",
      "update_url": "https://raw.githubusercontent.com/thecaaz/daily-challenges-web/refs/heads/main/extension/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "technicalAndInteraction",
          "personallyIdentifyingInfo"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "app-origins.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://challenges.caaz.dev/*",
        "https://test.challenges.caaz.dev/*",
        "https://timeguessr.com/*",
        "https://maptap.gg/*",
        "https://pfiffel.com/cutle/*",
        "https://blindcut.app/*",
        "https://motionpath.app/*",
        "http://localhost/*"
      ],
      "js": [
        "app-origins.js",
        "scoreparse.js",
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
