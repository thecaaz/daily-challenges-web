{
  "manifest_version": 2,
  "name": "DailyChallenges ScoreBridge",
  "version": "0.1.1",
  "description": "Extension that bridges embedded game scores and visible-tab captures into a parent page.",
  "permissions": [
    "<all_urls>",
    "tabs",
    "alarms",
    "notifications",
    "https://challenges.caaz.dev/*",
    "https://test.challenges.caaz.dev/*",
    "https://timeguessr.com/*",
    "https://maptap.gg/*",
    "http://localhost/*"
  ],
  "browser_action": {
    "default_title": "DailyChallenges ScoreBridge",
    "default_icon": "icons/favicon-96x96.png"
  },
  "icons": {
    "96": "icons/favicon-96x96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{b9dac5a9-12d3-4eec-8334-0343342947a2}",
      "update_url": "https://raw.githubusercontent.com/thecaaz/daily-challenges-web/refs/heads/main/extension/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "technicalAndInteraction",
          "personallyIdentifyingInfo"
        ]
      }
    }
  },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": [
        "https://challenges.caaz.dev/*",
        "https://test.challenges.caaz.dev/*",
        "https://timeguessr.com/*",
        "https://maptap.gg/*",
        "http://localhost/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
