{
  "manifest_version": 2,
  "name": "ScoreBridge-PoC",
  "version": "0.1.0",
  "description": "Extension that bridges embedded game scores and visible-tab captures into a parent page.",
  "permissions": ["storage", "activeTab", "tabs", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
