{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (backend)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build backend",
      "program": "${workspaceFolder}/backend/bin/Debug/net10.0/DailyChallenges.dll",
      "cwd": "${workspaceFolder}/backend",
      "args": [],
      "stopAtEntry": false
    },
    {
      "name": "Launch Frontend (npm)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Run Full Stack",
      "configurations": [".NET Core Launch (backend)", "Launch Frontend (npm)"]
    }
  ]
}
